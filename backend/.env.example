# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here


# Any model slug OpenRouter supports: https://openrouter.ai/models
# Good picks for code review: anthropic/claude-3.5-sonnet, openai/gpt-4o, qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional but recommended: raises GitHub's rate limit from 60/hr to 5000/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

PORT=4000
